@page "/"
@using System.ComponentModel.DataAnnotations
@using ZooTrack.Client.Services
@using ZooTrack.Client.Models
@inject IDashboardClientService DashboardService
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>ZooTrack - Dashboard</PageTitle>

<div class="hero-section mb-4">
    <div class="container-fluid">
        <h1 class="display-5 fw-bold text-primary mb-2">ZooTrack Dashboard</h1>
        <small class="text-muted">Last updated: @DateTime.Now.ToString("MMM dd, yyyy - HH:mm")</small>
    </div>
</div>

@if (_isLoading && _dashboardData == null)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2 text-muted">Loading dashboard data...</p>
    </div>
}
else if (_dashboardData != null)
{
    <!-- System Overview Cards -->
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100 bg-primary text-white">
                <div class="card-body text-center">
                    <i class="fas fa-video fa-2x mb-3"></i>
                    <h3 class="card-title fw-bold mb-1">@_dashboardData.Stats.ActiveDevicesCount</h3>
                    <p class="card-text small mb-0">Active Devices</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100 bg-success text-white">
                <div class="card-body text-center">
                    <i class="fas fa-paw fa-2x mb-3"></i>
                    <h3 class="card-title fw-bold mb-1">@_dashboardData.Stats.TodayDetections</h3>
                    <p class="card-text small mb-0">Detections (24h)</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100 bg-warning text-dark">
                <div class="card-body text-center">
                    <i class="fas fa-bell fa-2x mb-3"></i>
                    <h3 class="card-title fw-bold mb-1">@_dashboardData.Stats.CriticalAlerts</h3>
                    <p class="card-text small mb-0">Recent Alerts</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100 bg-info text-white">
                <div class="card-body text-center">
                    <i class="fas fa-clock fa-2x mb-3"></i>
                    <h3 class="card-title fw-bold mb-1">@_dashboardData.Stats.SystemUptime</h3>
                    <p class="card-text small mb-0">System Uptime</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Row -->
    <div class="row g-4">
        <!-- Device Status Section -->
        <div class="col-lg-8">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-camera me-2 text-primary"></i>Device Status
                    </h5>
                    <a href="/camera-dashboard" class="btn btn-sm btn-outline-primary">
                        Manage Devices <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        @if (_dashboardData.Devices?.Any() == true)
                        {
                            @foreach (var device in _dashboardData.Devices.Take(6))
                            {
                                <div class="col-md-6">
                                    <div class="border rounded p-3">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <h6 class="fw-bold mb-1">@device.Name</h6>
                                                <small class="text-muted">@device.Location</small>
                                            </div>
                                            <span class="badge @GetStatusBadgeClass(device.Status)">
                                                <i class="fas @GetStatusIcon(device.Status) me-1"></i>
                                                @device.Status
                                            </span>
                                        </div>
                                        @* FIX: Removed Battery Level display as it's a placeholder *@
                                        <div class="mt-2">
                                            <small class="text-muted">
                                                Last seen: @device.LastSeen.ToString("HH:mm")
                                            </small>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="col-12 text-center py-4">
                                <i class="fas fa-camera fa-3x text-muted mb-3"></i>
                                <p class="text-muted">No devices found</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <!-- Recent Alerts Section -->
        <div class="col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-bell me-2 text-warning"></i>Recent Alerts
                    </h5>
                    <a href="/system-logs" class="btn btn-sm btn-outline-primary">
                        View All <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        @if (_dashboardData.RecentAlerts?.Any() == true)
                        {
                            @foreach (var alert in _dashboardData.RecentAlerts.Take(5))
                            {
                                <div class="list-group-item border-0 py-3">
                                    <div class="d-flex align-items-start">
                                        <span class="badge @GetAlertBadgeClass(alert.Severity) me-3 mt-1">
                                            <i class="fas @GetAlertIcon(alert.Severity)"></i>
                                        </span>
                                        <div class="flex-grow-1">
                                            <h6 class="mb-1 fw-bold">@alert.Title</h6>
                                            <p class="mb-1 small text-muted">@alert.Message</p>
                                            @if (!string.IsNullOrEmpty(alert.DeviceName))
                                            {
                                                <small class="text-primary">@alert.DeviceName</small>
                                                <br />
                                            }
                                            <small class="text-muted">
                                                <i class="fas fa-clock me-1"></i>
                                                @alert.Timestamp.ToString("MMM dd, HH:mm")
                                            </small>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <i class="fas fa-check-circle text-success fa-2x mb-2"></i>
                                <p class="text-muted mb-0">No recent alerts</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else if (_errorMessage != null)
{
    <div class="alert alert-danger" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>
        <strong>Error:</strong> @_errorMessage
        <button type="button" class="btn btn-outline-danger btn-sm ms-3" @onclick="RefreshData">
            Try Again
        </button>
    </div>
}

@code {
    private DashboardData? _dashboardData;
    private bool _isLoading = true;
    private string? _errorMessage;
    private Timer? _refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardData();
        _refreshTimer = new Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await LoadDashboardData(silent: true);
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }

    private async Task LoadDashboardData(bool silent = false)
    {
        if (!silent)
        {
            _isLoading = true;
            _errorMessage = null;
        }

        try
        {
            _dashboardData = await DashboardService.GetDashboardDataAsync();
            _errorMessage = null;
        }
        catch (Exception ex)
        {
            _errorMessage = "Failed to load dashboard data. Please check your connection and try again.";
            Console.WriteLine($"Dashboard error: {ex.Message}");
        }
        finally
        {
            if (!silent)
                _isLoading = false;
        }
    }

    private async Task RefreshData()
    {
        await LoadDashboardData();
    }

    private string GetStatusBadgeClass(string status) => status switch { "Online" => "bg-success", "Offline" => "bg-danger", "Warning" => "bg-warning", _ => "bg-secondary" };
    private string GetStatusIcon(string status) => status switch { "Online" => "fa-check-circle", "Offline" => "fa-times-circle", "Warning" => "fa-exclamation-triangle", _ => "fa-question-circle" };
    private string GetAlertBadgeClass(string severity) => severity switch { "Critical" => "bg-danger", "Warning" => "bg-warning", "Info" => "bg-info", _ => "bg-secondary" };
    private string GetAlertIcon(string severity) => severity switch { "Critical" => "fa-exclamation-triangle", "Warning" => "fa-exclamation-circle", "Info" => "fa-info-circle", _ => "fa-bell" };
}