@page "/detections"
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject ILogger<DetectionHistoryPage> Logger
@using System.Text.Json

<PageTitle>Detection History - ZooTrack</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h2 class="mb-2">
                <i class="bi bi-search me-2 text-primary"></i>
                Detection History
            </h2>
            <p class="text-muted">Browse and manage animal detection records</p>
        </div>
    </div>

    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-light">
            <h5 class="mb-0">
                <i class="bi bi-funnel me-2"></i>
                Filters
            </h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label for="animalType" class="form-label">Animal Type:</label>
                    <select class="form-select" id="animalType" @bind="selectedAnimalType" @bind:after="ApplyFiltersAndPagination">
                        <option value="">All Animals</option>
                        @if (targetAnimals != null)
                        {
                            @foreach (var animal in targetAnimals)
                            {
                                <option value="@animal">@CapitalizeFirstLetter(animal)</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="deviceId" class="form-label">Device:</label>
                    <select class="form-select" id="deviceId" @bind="selectedDevice" @bind:after="ApplyFiltersAndPagination">
                        <option value="">All Devices</option>
                        @if (availableDevices != null)
                        {
                            @foreach (var device in availableDevices)
                            {
                                <option value="@device.DeviceId">@device.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="dateFrom" class="form-label">From Date:</label>
                    <input type="date" class="form-control" id="dateFrom" @bind="dateFrom" @bind:after="LoadDetections" />
                </div>
                <div class="col-md-2">
                    <label for="dateTo" class="form-label">To Date:</label>
                    <input type="date" class="form-control" id="dateTo" @bind="dateTo" @bind:after="LoadDetections" />
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button class="btn btn-primary me-2" @onclick="LoadDetections" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        }
                        <i class="bi bi-arrow-clockwise me-1"></i>
                        Refresh
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="ClearFilters">
                        <i class="bi bi-x-circle me-1"></i>
                        Clear
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (isLoading && allDetections == null)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status">
                <span class="visually-hidden">Loading detections...</span>
            </div>
            <p class="text-muted">Loading detection records...</p>
        </div>
    }
    else if (allDetections != null)
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <span class="badge bg-primary fs-6">
                    @filteredDetections.Count Detection@(filteredDetections.Count != 1 ? "s" : "") Found
                </span>
            </div>
            <small class="text-muted">
                <i class="bi bi-clock me-1"></i>
                Last updated: @DateTime.Now.ToString("HH:mm:ss")
            </small>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-0">
                @if (currentPageDetections.Count == 0)
                {
                    <div class="text-center py-5">
                        <i class="bi bi-search display-1 text-muted mb-3"></i>
                        <h5 class="text-muted">No detections found</h5>
                        <p class="text-muted">Try adjusting your filter criteria</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover table-striped mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th scope="col">Detection ID</th>
                                    <th scope="col">Date & Time</th>
                                    <th scope="col">Detected Object</th>
                                    <th scope="col">Device</th>
                                    <th scope="col">Confidence</th>
                                    <th scope="col">Thumbnail</th>
                                    <th scope="col">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var detection in currentPageDetections)
                                {
                                    <tr>
                                        <td><span class="badge bg-secondary">#@detection.DetectionId</span></td>
                                        <td><strong>@detection.DetectedAt.ToString("MMM dd, yyyy HH:mm:ss")</strong></td>
                                        <td>
                                            <span class="badge @GetAnimalBadgeClass(detection.DetectedObject) fs-6">
                                                @CapitalizeFirstLetter(detection.DetectedObject ?? "Unknown")
                                            </span>
                                        </td>
                                        <td><span class="badge bg-info text-dark">@(detection.Device?.Location ?? $"Device {detection.DeviceId}")</span></td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="progress me-2" style="width: 60px; height: 8px;">
                                                    <div class="progress-bar @GetConfidenceColor(detection.Confidence)" style="width: @(detection.Confidence)%"></div>
                                                </div>
                                                <small class="text-muted">@(detection.Confidence.ToString("F1"))%</small>
                                            </div>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(detection.Media?.FilePath))
                                            {
                                                <img src="@GetFullImagePath(detection.Media.FilePath)" alt="Detection thumbnail" class="thumbnail-image" @onclick="() => ShowImageModal(detection)" title="Click to view full image" />
                                            }
                                            else
                                            {
                                                <div class="thumbnail-placeholder"><i class="bi bi-image text-muted"></i></div>
                                            }
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-outline-success" @onclick="() => DownloadImage(detection)" disabled="@string.IsNullOrEmpty(detection.Media?.FilePath)" title="Download Image">
                                                    <i class="bi bi-download"></i>
                                                </button>
                                                <button class="btn btn-outline-danger" @onclick="() => ShowDeleteConfirmation(detection)" title="Delete Detection">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        @if (totalPages > 1)
        {
            <div class="d-flex justify-content-between align-items-center mt-4">
                <div>
                    <small class="text-muted">
                        Page @currentPage of @totalPages (showing @currentPageDetections.Count of @filteredDetections.Count detections)
                    </small>
                </div>
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => GoToPage(currentPage - 1)">Previous</button>
                        </li>
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="() => GoToPage(currentPage + 1)">Next</button>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    }
</div>

@if (selectedDetection != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-camera-fill me-2 text-primary"></i>
                        Detection #@selectedDetection.DetectionId
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseImageModal"></button>
                </div>
                <div class="modal-body">
                    <div class="text-center mb-3">
                        <img src="@GetFullImagePath(selectedDetection.Media?.FilePath)" alt="Detection of @selectedDetection.DetectedObject" class="img-fluid rounded shadow" style="max-height: 70vh;" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary" @onclick="() => DownloadImage(selectedDetection)">
                        <i class="bi bi-download me-1"></i>Download Image
                    </button>
                    <button class="btn btn-secondary" @onclick="CloseImageModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showDeleteModal && detectionToDelete != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-danger">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        Confirm Deletion
                    </h5>
                    <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to permanently delete detection #@detectionToDelete.DetectionId?</p>
                    <div class="alert alert-warning">This action cannot be undone.</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">Delete Detection</button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .thumbnail-image {
        width: 80px;
        height: 50px;
        object-fit: cover;
        border-radius: 4px;
        cursor: pointer;
        transition: transform 0.2s ease;
    }

        .thumbnail-image:hover {
            transform: scale(1.1);
        }

    .thumbnail-placeholder {
        width: 80px;
        height: 50px;
        background-color: #f8f9fa;
        border: 1px dashed #dee2e6;
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>

@code {
    private List<DetectionRecord>? allDetections;
    private List<DetectionRecord> filteredDetections = new();
    private List<DetectionRecord> currentPageDetections = new();

    private List<string> targetAnimals = new();
    private List<DeviceViewModel> availableDevices = new();

    private bool isLoading = false;
    private string? errorMessage;
    private string selectedAnimalType = "";
    private string selectedDevice = "";
    private DateOnly? dateFrom;
    private DateOnly? dateTo;
    private DetectionRecord? selectedDetection;
    private bool showDeleteModal = false;
    private DetectionRecord? detectionToDelete;

    private int currentPage = 1;
    private int pageSize = 15;
    private int totalPages => (int)Math.Ceiling((double)filteredDetections.Count / pageSize);

    protected override async Task OnInitializedAsync()
    {
        dateTo = DateOnly.FromDateTime(DateTime.Today);
        dateFrom = dateTo.Value.AddDays(-7);
        await LoadInitialData();
    }

    private async Task LoadInitialData()
    {
        isLoading = true;
        await Task.WhenAll(LoadDevices(), LoadDetections());
        await LoadDistinctAnimalTypes();
        isLoading = false;
    }

    private async Task LoadDetections()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var fromDateStr = dateFrom?.ToString("yyyy-MM-dd");
            var toDateStr = dateTo?.ToString("yyyy-MM-dd");
            var response = await Http.GetFromJsonAsync<List<DetectionRecord>>($"api/detection?from={fromDateStr}&to={toDateStr}");
            allDetections = response ?? new List<DetectionRecord>();
            ApplyFiltersAndPagination();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading detections: {ex.Message}";
            Logger.LogError(ex, "Failed to load detections.");
        }
        isLoading = false;
    }

    private async Task LoadDevices()
    {
        try
        {
            var devices = await Http.GetFromJsonAsync<List<DeviceViewModel>>("api/device");
            if (devices != null)
            {
                availableDevices = devices.Select(d => new DeviceViewModel
                {
                    DeviceId = d.DeviceId,
                    Name = $"Camera {d.DeviceId} ({d.Location})"
                }).ToList();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load devices for filter.");
        }
    }

    private async Task LoadDistinctAnimalTypes()
    {
        try
        {
            if (allDetections != null && allDetections.Any())
            {
                targetAnimals = allDetections
                    .Where(d => !string.IsNullOrEmpty(d.DetectedObject))
                    .Select(d => d.DetectedObject!)
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .OrderBy(name => name)
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to build distinct animal list.");
        }
    }

    private void ApplyFiltersAndPagination()
    {
        if (allDetections == null) return;

        filteredDetections = allDetections.Where(d =>
            (string.IsNullOrEmpty(selectedAnimalType) || string.Equals(d.DetectedObject, selectedAnimalType, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(selectedDevice) || d.DeviceId.ToString() == selectedDevice)
        ).ToList();

        GoToPage(1);
    }

    private async Task ClearFilters()
    {
        selectedAnimalType = "";
        selectedDevice = "";
        dateTo = DateOnly.FromDateTime(DateTime.Today);
        dateFrom = dateTo.Value.AddDays(-7);
        await LoadDetections();
    }

    private void GoToPage(int page)
    {
        if (page < 1) page = 1;
        if (page > totalPages && totalPages > 0) page = totalPages;

        currentPage = page;

        var skip = (currentPage - 1) * pageSize;
        currentPageDetections = filteredDetections.Skip(skip).Take(pageSize).ToList();
    }

    private async Task DownloadImage(DetectionRecord detection)
    {
        if (string.IsNullOrEmpty(detection.Media?.FilePath)) return;

        try
        {
            var fullUrl = GetFullImagePath(detection.Media.FilePath);
            var fileName = Path.GetFileName(detection.Media.FilePath);

            var imageData = await Http.GetByteArrayAsync(fullUrl);

            using var streamRef = new DotNetStreamReference(new MemoryStream(imageData));
            await JSRuntime.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to download image: {ex.Message}";
            Logger.LogError(ex, "Error downloading image for detection {Id}", detection.DetectionId);
        }
    }

    private void ShowImageModal(DetectionRecord detection) => selectedDetection = detection;
    private void CloseImageModal() => selectedDetection = null;

    private void ShowDeleteConfirmation(DetectionRecord detection)
    {
        detectionToDelete = detection;
        showDeleteModal = true;
    }

    private void CancelDelete()
    {
        detectionToDelete = null;
        showDeleteModal = false;
    }

    private async Task ConfirmDelete()
    {
        if (detectionToDelete == null) return;

        try
        {
            var response = await Http.DeleteAsync($"api/detection/{detectionToDelete.DetectionId}");
            if (response.IsSuccessStatusCode)
            {
                allDetections?.RemoveAll(d => d.DetectionId == detectionToDelete.DetectionId);
                ApplyFiltersAndPagination();
            }
            else
            {
                errorMessage = $"Failed to delete detection: {await response.Content.ReadAsStringAsync()}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting detection: {ex.Message}";
        }
        finally
        {
            CancelDelete();
        }
    }

    private string GetFullImagePath(string? relativePath)
    {
        if (string.IsNullOrEmpty(relativePath) || Http.BaseAddress == null)
        {
            return "";
        }

        var fullUri = new Uri(Http.BaseAddress, relativePath);
        return fullUri.ToString();
    }

    private string CapitalizeFirstLetter(string input)
    {
        if (string.IsNullOrEmpty(input)) return input;
        return char.ToUpper(input[0]) + input.Substring(1);
    }

    private string GetConfidenceColor(float confidence) => confidence switch { >= 80 => "bg-success", >= 60 => "bg-warning", _ => "bg-danger" };
    private string GetAnimalBadgeClass(string? animal) => animal?.ToLower() switch { "person" => "bg-danger", "lion" or "tiger" => "bg-warning text-dark", _ => "bg-primary" };

    public class DetectionRecord
    {
        public int DetectionId { get; set; }
        public DateTime DetectedAt { get; set; }
        public string? DetectedObject { get; set; }
        public float Confidence { get; set; }
        public int DeviceId { get; set; }
        public DeviceViewModel? Device { get; set; }
        public MediaRecord? Media { get; set; }
    }

    public class DeviceViewModel
    {
        public int DeviceId { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Location { get; set; } = string.Empty;
    }

    public class MediaRecord
    {
        public int MediaId { get; set; }
        public string FilePath { get; set; } = string.Empty;
    }
}