@page "/detections"
@inject HttpClient Http
@inject ILogger<DetectionHistoryPage> Logger

<PageTitle>Detection History - ZooTrack</PageTitle>

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col">
            <h2 class="mb-2">
                <i class="bi bi-search me-2 text-primary"></i>
                Detection History
            </h2>
            <p class="text-muted">View all detected animals from your cameras</p>
        </div>
    </div>

    <!-- Filters Card -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-light">
            <h5 class="mb-0"><i class="bi bi-funnel me-2"></i>Filter Detections</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">From Date:</label>
                    <input type="date" class="form-control" @bind="filterFromDate" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">To Date:</label>
                    <input type="date" class="form-control" @bind="filterToDate" />
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button class="btn btn-primary w-100" @onclick="LoadDetectionsAsync" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        <i class="bi bi-arrow-clockwise me-1"></i>
                        Load Detections
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Error Message -->
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle me-2"></i>
            <strong>Error:</strong> @errorMessage
            <button type="button" class="btn-close" @onclick="@(() => errorMessage = null)"></button>
        </div>
    }

    <!-- Loading State -->
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="text-muted">Loading detection records...</p>
        </div>
    }

    <!-- Results -->
    @if (!isLoading && detections != null)
    {
        <div class="card shadow-sm">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-list-ul me-2"></i>
                    Detection Results
                </h5>
                <span class="badge bg-primary fs-6">@detections.Count Record(s)</span>
            </div>
            <div class="card-body p-0">
                @if (detections.Count == 0)
                {
                    <div class="text-center py-5">
                        <i class="bi bi-inbox display-1 text-muted mb-3"></i>
                        <h5 class="text-muted">No Detections Found</h5>
                        <p class="text-muted">Try adjusting your date range or check if cameras are running</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover table-striped mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th>ID</th>
                                    <th>Date & Time</th>
                                    <th>Detected Object</th>
                                    <th>Device</th>
                                    <th>Confidence</th>
                                    <th>Image</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var detection in detections)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge bg-secondary">#@detection.DetectionId</span>
                                        </td>
                                        <td>
                                            <strong>@detection.DetectedAt.ToString("yyyy-MM-dd")</strong>
                                            <br />
                                            <small class="text-muted">@detection.DetectedAt.ToString("HH:mm:ss")</small>
                                        </td>
                                        <td>
                                            <span class="badge bg-info fs-6">
                                                @(string.IsNullOrEmpty(detection.DetectedObject) ? "Unknown" : detection.DetectedObject)
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge bg-warning text-dark">
                                                Camera @detection.DeviceId
                                            </span>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="progress me-2" style="width: 80px; height: 10px;">
                                                    <div class="progress-bar @GetConfidenceColorClass(detection.Confidence)"
                                                         style="width: @(detection.Confidence)%">
                                                    </div>
                                                </div>
                                                <small>@detection.Confidence.ToString("F1")%</small>
                                            </div>
                                        </td>
                                        <td>
                                            @if (detection.Media != null && !string.IsNullOrEmpty(detection.Media.FilePath))
                                            {
                                                <img src="@GetImageUrl(detection.Media.FilePath)"
                                                     alt="Detection"
                                                     class="img-thumbnail"
                                                     style="width: 80px; height: 60px; object-fit: cover; cursor: pointer;"
                                                     @onclick="@(() => ShowImageModal(detection))" />
                                            }
                                            else
                                            {
                                                <div class="text-muted small">
                                                    <i class="bi bi-image"></i> No image
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- Image Modal -->
@if (selectedDetection != null && selectedDetection.Media != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.7);" @onclick="CloseImageModal">
        <div class="modal-dialog modal-lg modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-camera-fill me-2"></i>
                        Detection #@selectedDetection.DetectionId - @selectedDetection.DetectedObject
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseImageModal"></button>
                </div>
                <div class="modal-body text-center">
                    <img src="@GetImageUrl(selectedDetection.Media.FilePath)"
                         alt="Detection"
                         class="img-fluid rounded"
                         style="max-height: 70vh;" />
                    <div class="mt-3">
                        <p><strong>Date:</strong> @selectedDetection.DetectedAt.ToString("yyyy-MM-dd HH:mm:ss")</p>
                        <p><strong>Confidence:</strong> @selectedDetection.Confidence.ToString("F1")%</p>
                        <p><strong>Camera:</strong> @selectedDetection.DeviceId</p>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseImageModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // State
    private List<DetectionDto>? detections = null;
    private bool isLoading = false;
    private string? errorMessage = null;
    private DetectionDto? selectedDetection = null;

    // Filters - Changed to DateTime type
    private DateTime filterFromDate = DateTime.Today.AddDays(-7);
    private DateTime filterToDate = DateTime.Today;

    // Lifecycle
    protected override async Task OnInitializedAsync()
    {
        await LoadDetectionsAsync();
    }

    // Methods
    private async Task LoadDetectionsAsync()
    {
        isLoading = true;
        errorMessage = null;
        detections = null;

        try
        {
            // Build API URL with query parameters - format dates as strings
            var fromDateStr = filterFromDate.ToString("yyyy-MM-dd");
            var toDateStr = filterToDate.ToString("yyyy-MM-dd");
            var apiUrl = $"api/detection?from={fromDateStr}&to={toDateStr}";

            Logger.LogInformation("Fetching detections from: {ApiUrl}", apiUrl);

            // Make the API call
            var response = await Http.GetAsync(apiUrl);

            Logger.LogInformation("Response status: {StatusCode}", response.StatusCode);

            if (response.IsSuccessStatusCode)
            {
                detections = await response.Content.ReadFromJsonAsync<List<DetectionDto>>();
                Logger.LogInformation("Successfully loaded {Count} detections", detections?.Count ?? 0);
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Failed to load detections: {response.StatusCode} - {errorContent}";
                Logger.LogError("API Error: {Error}", errorMessage);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading detections: {ex.Message}";
            Logger.LogError(ex, "Exception while loading detections");
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetImageUrl(string relativePath)
    {
        if (string.IsNullOrEmpty(relativePath))
            return "";

        // Build full URL from backend base address
        var baseUrl = Http.BaseAddress?.ToString().TrimEnd('/') ?? "https://localhost:7019";
        return $"{baseUrl}/{relativePath.TrimStart('/')}";
    }

    private string GetConfidenceColorClass(float confidence)
    {
        if (confidence >= 80) return "bg-success";
        if (confidence >= 60) return "bg-warning";
        return "bg-danger";
    }

    private void ShowImageModal(DetectionDto detection)
    {
        selectedDetection = detection;
    }

    private void CloseImageModal()
    {
        selectedDetection = null;
    }

    // DTOs
    public class DetectionDto
    {
        public int DetectionId { get; set; }
        public DateTime DetectedAt { get; set; }
        public string? DetectedObject { get; set; }
        public float Confidence { get; set; }
        public int DeviceId { get; set; }
        public MediaDto? Media { get; set; }
    }

    public class MediaDto
    {
        public int MediaId { get; set; }
        public string FilePath { get; set; } = "";
    }
}