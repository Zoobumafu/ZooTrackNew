@page "/detections"
@using System.Net.Http.Json
@using System.Text.Json
@inject HttpClient Http
@inject ILogger<DetectionHistoryPage> Logger

<PageTitle>Detection History - ZooTrack</PageTitle>

<h3>Detection History</h3>
<p class="text-muted">View all animal detection events</p>

<!-- Date Filter Section -->
<div class="row mb-3">
    <div class="col-md-3">
        <label for="dateFrom" class="form-label">From Date:</label>
        <input type="date" class="form-control" id="dateFrom" @bind="dateFrom" @bind:after="ReloadFromFirstPage" />
    </div>

    <div class="col-md-3">
        <label for="dateTo" class="form-label">To Date:</label>
        <input type="date" class="form-control" id="dateTo" @bind="dateTo" @bind:after="ReloadFromFirstPage" />
    </div>

    <div class="col-md-3 d-flex align-items-end">
        <button class="btn btn-primary me-2" @onclick="ReloadFromFirstPage" disabled="@isLoading">
            @if (isLoading)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
            }
            Refresh
        </button>
        <button class="btn btn-outline-secondary me-2" @onclick="ClearFilters">Clear Filters</button>
        <button class="btn btn-outline-warning" @onclick="LoadAllDetections" disabled="@isLoading">Load ALL</button>
    </div>
</div>

<!-- Always-visible Debug Toggle -->
<div class="mb-3">
    <button class="btn btn-sm btn-outline-secondary" @onclick="ShowDebugInfo">
        <i class="bi bi-bug"></i> @(showDebugInfo ? "Hide" : "Show") Debug Info
    </button>
</div>

@if (showDebugInfo)
{
    <div class="card mb-3 border-info">
        <div class="card-header bg-info text-white">
            <strong>🔍 Debug Information</strong>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <h6>Request Info:</h6>
                    <pre style="font-size: 11px;">@debugInfo</pre>
                </div>
                <div class="col-md-6">
                    <h6>Detections Data:</h6>
                    <ul style="font-size: 11px; max-height: 300px; overflow-y: auto;">
                        @if (detections == null)
                        {
                            <li><strong>detections is NULL</strong></li>
                        }
                        else if (detections.Count == 0)
                        {
                            <li><strong>detections is EMPTY LIST (Count = 0)</strong></li>
                        }
                        else
                        {
                            <li><strong>Total Count: @detections.Count</strong></li>
                            @foreach (var d in detections.Take(10))
                            {
                                <li>ID: @d.DetectionId | Time: @d.DetectedAt.ToString("MM/dd HH:mm:ss") | Object: @(d.DetectedObject ?? "null") | Conf: @d.Confidence.ToString("F1")%</li>
                            }
                            @if (detections.Count > 10)
                            {
                                <li><em>... and @(detections.Count - 10) more</em></li>
                            }
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(filterInfo))
{
    <div class="alert alert-info" role="alert">
        <i class="bi bi-info-circle me-2"></i>@filterInfo
    </div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @errorMessage
    </div>
}

@if (isLoading && detections == null)
{
    <div class="d-flex justify-content-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading detections...</span>
        </div>
    </div>
}
else if (detections != null)
{
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="bi bi-eye me-2"></i>
                Detection History (@detections.Count records)
            </h5>
            <small class="text-muted">Last updated: @lastUpdateTime.ToString("HH:mm:ss")</small>
        </div>
        <div class="card-body p-0">
            @if (detections.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox display-1 text-muted"></i>
                    <p class="text-muted mt-3">No detections found matching your criteria</p>
                    <button class="btn btn-primary" @onclick="ReloadFromFirstPage">Refresh Data</button>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Detected At</th>
                                <th>Object</th>
                                <th>Confidence</th>
                                <th>Device</th>
                                <th>Tracking ID</th>
                                <th>Frame #</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var detection in detections)
                            {
                                <tr class="@GetRowClass(detection.Confidence)">
                                    <td>@detection.DetectionId</td>
                                    <td class="text-nowrap small">
                                        @detection.DetectedAt.ToString("MM/dd/yyyy HH:mm:ss")
                                    </td>
                                    <td>
                                        <span class="badge bg-info">
                                            @(detection.DetectedObject ?? "Unknown")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge @GetConfidenceBadgeClass(detection.Confidence)">
                                            @detection.Confidence.ToString("F1")%
                                        </span>
                                    </td>
                                    <td>Device @detection.DeviceId</td>
                                    <td>@(detection.TrackingId?.ToString() ?? "-")</td>
                                    <td>@detection.FrameNumber</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

<style>
    .table th {
        border-top: none;
        font-weight: 600;
        font-size: 0.875rem;
    }

    .detection-high {
        background-color: rgba(40, 167, 69, 0.05);
        border-left: 3px solid #28a745;
    }

    .detection-medium {
        background-color: rgba(255, 193, 7, 0.05);
        border-left: 3px solid #ffc107;
    }

    .detection-low {
        background-color: rgba(220, 53, 69, 0.05);
        border-left: 3px solid #dc3545;
    }
</style>

@code {
    private List<DetectionDto>? detections;
    private DateOnly? dateFrom;
    private DateOnly? dateTo;
    private bool isLoading = false;
    private string? errorMessage;
    private string? filterInfo;
    private string? debugInfo;
    private bool showDebugInfo = false;
    private DateTime lastUpdateTime = DateTime.Now;

    protected override async Task OnInitializedAsync()
    {
        // Set default date range to last 7 days (matching SystemLogsPage pattern)
        dateTo = DateOnly.FromDateTime(DateTime.Today);
        dateFrom = DateOnly.FromDateTime(DateTime.Today.AddDays(-7));

        Logger.LogInformation("DetectionHistoryPage initialized with date range: {From} to {To}", dateFrom, dateTo);

        await LoadDetections();
    }

    private async Task LoadDetections()
    {
        isLoading = true;
        errorMessage = null;
        filterInfo = null;
        debugInfo = null;
        StateHasChanged();

        try
        {
            var queryParams = new List<string>();

            if (dateFrom.HasValue)
            {
                queryParams.Add($"from={dateFrom.Value:yyyy-MM-dd}");
            }

            if (dateTo.HasValue)
            {
                queryParams.Add($"to={dateTo.Value:yyyy-MM-dd}");
            }

            // Add cache-busting parameter
            queryParams.Add($"_t={DateTimeOffset.UtcNow.ToUnixTimeSeconds()}");

            var queryString = queryParams.Count > 0 ? "?" + string.Join("&", queryParams) : "";
            var url = $"api/detection{queryString}";

            Logger.LogInformation("Loading detections from: {Url}", url);

            var response = await Http.GetAsync(url);
            var content = await response.Content.ReadAsStringAsync();

            // Build debug information
            var debugBuilder = new System.Text.StringBuilder();
            debugBuilder.AppendLine($"Request URL: {url}");
            debugBuilder.AppendLine($"Response Status: {response.StatusCode}");
            debugBuilder.AppendLine($"Response Content Length: {content?.Length ?? 0}");
            debugBuilder.AppendLine($"Current Time: {DateTime.Now:yyyy-MM-dd HH:mm:ss}");
            debugBuilder.AppendLine($"Date From: {dateFrom?.ToString("yyyy-MM-dd") ?? "null"}");
            debugBuilder.AppendLine($"Date To: {dateTo?.ToString("yyyy-MM-dd") ?? "null"}");

            Logger.LogInformation("API Response Status: {StatusCode}, Content Length: {Length}",
                response.StatusCode, content?.Length ?? 0);

            if (response.IsSuccessStatusCode)
            {
                var options = new JsonSerializerOptions
                    {
                        PropertyNameCaseInsensitive = true
                    };

                detections = JsonSerializer.Deserialize<List<DetectionDto>>(content, options);

                debugBuilder.AppendLine($"Deserialized Count: {detections?.Count ?? 0}");

                if (detections != null)
                {
                    Logger.LogInformation("Successfully loaded {Count} detections", detections.Count);

                    if (detections.Any())
                    {
                        var newest = detections.OrderByDescending(d => d.DetectedAt).First();
                        var oldest = detections.OrderBy(d => d.DetectedAt).First();

                        debugBuilder.AppendLine($"Oldest Detection: {oldest.DetectedAt:yyyy-MM-dd HH:mm:ss}");
                        debugBuilder.AppendLine($"Newest Detection: {newest.DetectedAt:yyyy-MM-dd HH:mm:ss}");

                        filterInfo = $"Showing {detections.Count} detection(s) from {dateFrom?.ToString("MM/dd/yyyy") ?? "start"} to {dateTo?.ToString("MM/dd/yyyy") ?? "end"}";
                    }
                    else
                    {
                        filterInfo = "No detections found in the selected date range.";
                    }

                    lastUpdateTime = DateTime.Now;
                }
            }
            else
            {
                errorMessage = $"Failed to load detections. Status: {response.StatusCode}";
                debugBuilder.AppendLine($"Error Content: {content}");
                Logger.LogError("API returned error: {StatusCode} - {Content}", response.StatusCode, content);
            }

            debugInfo = debugBuilder.ToString();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading detections: {ex.Message}";
            Logger.LogError(ex, "Exception while loading detections");

            debugInfo = $"Exception Type: {ex.GetType().Name}\n" +
                       $"Message: {ex.Message}\n" +
                       $"Stack Trace:\n{ex.StackTrace}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ReloadFromFirstPage()
    {
        Logger.LogInformation("Reloading detections from first page");
        await LoadDetections();
    }

    private async Task ClearFilters()
    {
        dateFrom = DateOnly.FromDateTime(DateTime.Today.AddDays(-7));
        dateTo = DateOnly.FromDateTime(DateTime.Today);
        Logger.LogInformation("Filters cleared, reloading with defaults");
        await LoadDetections();
    }

    private async Task LoadAllDetections()
    {
        isLoading = true;
        errorMessage = null;
        filterInfo = null;
        debugInfo = null;
        StateHasChanged();

        try
        {
            // NO date filters - get everything
            var url = $"api/detection?_t={DateTimeOffset.UtcNow.ToUnixTimeSeconds()}";

            Logger.LogInformation("Loading ALL detections (no filters) from: {Url}", url);

            var response = await Http.GetAsync(url);
            var content = await response.Content.ReadAsStringAsync();

            var debugBuilder = new System.Text.StringBuilder();
            debugBuilder.AppendLine($"Request URL (NO FILTERS): {url}");
            debugBuilder.AppendLine($"Response Status: {response.StatusCode}");
            debugBuilder.AppendLine($"Response Content Length: {content?.Length ?? 0}");
            debugBuilder.AppendLine($"Current Time: {DateTime.Now:yyyy-MM-dd HH:mm:ss}");

            Logger.LogInformation("API Response Status: {StatusCode}, Content Length: {Length}",
                response.StatusCode, content?.Length ?? 0);

            if (response.IsSuccessStatusCode)
            {
                var options = new JsonSerializerOptions
                    {
                        PropertyNameCaseInsensitive = true
                    };

                detections = JsonSerializer.Deserialize<List<DetectionDto>>(content, options);

                debugBuilder.AppendLine($"Deserialized Count: {detections?.Count ?? 0}");

                if (detections != null)
                {
                    Logger.LogInformation("Successfully loaded {Count} detections (ALL, no filters)", detections.Count);

                    if (detections.Any())
                    {
                        var newest = detections.OrderByDescending(d => d.DetectedAt).First();
                        var oldest = detections.OrderBy(d => d.DetectedAt).First();

                        debugBuilder.AppendLine($"Oldest Detection: {oldest.DetectedAt:yyyy-MM-dd HH:mm:ss}");
                        debugBuilder.AppendLine($"Newest Detection: {newest.DetectedAt:yyyy-MM-dd HH:mm:ss}");

                        filterInfo = $"Showing ALL {detections.Count} detection(s) in database (no date filters)";
                    }
                    else
                    {
                        filterInfo = "No detections found in database at all!";
                    }

                    lastUpdateTime = DateTime.Now;
                }
            }
            else
            {
                errorMessage = $"Failed to load detections. Status: {response.StatusCode}";
                debugBuilder.AppendLine($"Error Content: {content}");
                Logger.LogError("API returned error: {StatusCode} - {Content}", response.StatusCode, content);
            }

            debugInfo = debugBuilder.ToString();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading detections: {ex.Message}";
            Logger.LogError(ex, "Exception while loading ALL detections");

            debugInfo = $"Exception Type: {ex.GetType().Name}\n" +
                       $"Message: {ex.Message}\n" +
                       $"Stack Trace:\n{ex.StackTrace}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ShowDebugInfo()
    {
        showDebugInfo = !showDebugInfo;
        StateHasChanged();
    }

    private string GetConfidenceBadgeClass(float confidence)
    {
        return confidence switch
        {
            >= 90 => "bg-success",
            >= 80 => "bg-warning text-dark",
            _ => "bg-danger"
        };
    }

    private string GetRowClass(float confidence)
    {
        return confidence switch
        {
            >= 90 => "detection-high",
            >= 80 => "detection-medium",
            _ => "detection-low"
        };
    }

    // DTO class that matches the backend Detection model
    public class DetectionDto
    {
        public int DetectionId { get; set; }
        public float Confidence { get; set; }
        public DateTime DetectedAt { get; set; }
        public int DeviceId { get; set; }
        public string? DetectedObject { get; set; }
        public int? MediaId { get; set; }
        public int? EventId { get; set; }
        public int? TrackingId { get; set; }
        public float BoundingBoxX { get; set; }
        public float BoundingBoxY { get; set; }
        public float BoundingBoxWidth { get; set; }
        public float BoundingBoxHeight { get; set; }
        public int FrameNumber { get; set; }
        public bool IsTarget { get; set; }
    }
}