@page "/detections"
@inject HttpClient Http
@inject ILogger<DetectionHistoryPage> Logger

<PageTitle>Detection History - ZooTrack</PageTitle>

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col">
            <h2 class="mb-2">
                <i class="bi bi-search me-2 text-primary"></i>
                Detection History
            </h2>
            <p class="text-muted">View and filter animal detections from your cameras</p>
        </div>
    </div>

    <!-- Filters Card -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-light">
            <h5 class="mb-0"><i class="bi bi-funnel me-2"></i>Filter Detections</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label fw-bold">From Date:</label>
                    <input type="date" class="form-control" @bind="dateFrom" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">To Date:</label>
                    <input type="date" class="form-control" @bind="dateTo" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">Detected Object:</label>
                    <select class="form-select" @bind="filterObject">
                        <option value="">All Objects</option>
                        @foreach (var obj in availableObjects)
                        {
                            <option value="@obj">@obj</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end gap-2">
                    <button class="btn btn-primary flex-fill" @onclick="LoadDetections" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        <i class="bi bi-arrow-clockwise me-1"></i>
                        Apply Filters
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="ClearFilters" disabled="@isLoading">
                        <i class="bi bi-x-circle"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Error Message -->
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle me-2"></i>
            <strong>Error:</strong> @errorMessage
            <button type="button" class="btn-close" @onclick="@(() => errorMessage = null)"></button>
        </div>
    }

    <!-- Loading State -->
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="text-muted">Loading detections...</p>
        </div>
    }

    <!-- Results -->
    @if (!isLoading && detections != null)
    {
        <div class="card shadow-sm">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-list-ul me-2"></i>
                    Detection Results
                </h5>
                <span class="badge bg-primary fs-6">@filteredDetections.Count Record(s)</span>
            </div>
            <div class="card-body p-0">
                @if (filteredDetections.Count == 0)
                {
                    <div class="text-center py-5">
                        <i class="bi bi-inbox display-1 text-muted mb-3"></i>
                        <h5 class="text-muted">No Detections Found</h5>
                        <p class="text-muted">Try adjusting your filters or check if cameras are detecting animals</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover table-striped mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th style="width: 80px;">ID</th>
                                    <th style="width: 180px;">Date & Time</th>
                                    <th style="width: 150px;">Detected Object</th>
                                    <th style="width: 120px;">Device</th>
                                    <th style="width: 150px;">Confidence</th>
                                    <th style="width: 120px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var detection in filteredDetections)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge bg-secondary">#@detection.DetectionId</span>
                                        </td>
                                        <td>
                                            <strong>@detection.DetectedAt.ToString("yyyy-MM-dd")</strong>
                                            <br />
                                            <small class="text-muted">@detection.DetectedAt.ToString("HH:mm:ss")</small>
                                        </td>
                                        <td>
                                            <span class="badge bg-info text-dark fs-6">
                                                @(string.IsNullOrEmpty(detection.DetectedObject) ? "Unknown" : detection.DetectedObject)
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge bg-warning text-dark">
                                                Camera @detection.DeviceId
                                            </span>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="progress me-2" style="width: 80px; height: 10px;">
                                                    <div class="progress-bar @GetConfidenceColorClass(detection.Confidence)"
                                                         style="width: @(detection.Confidence)%">
                                                    </div>
                                                </div>
                                                <small class="fw-bold">@detection.Confidence.ToString("F1")%</small>
                                            </div>
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => ShowDetails(detection)">
                                                <i class="bi bi-eye"></i> View
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- Details Modal -->
@if (selectedDetection != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.7);" @onclick="CloseModal">
        <div class="modal-dialog modal-lg modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-info-circle me-2"></i>
                        Detection #@selectedDetection.DetectionId
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Date & Time:</strong> @selectedDetection.DetectedAt.ToString("yyyy-MM-dd HH:mm:ss")</p>
                            <p><strong>Detected Object:</strong> <span class="badge bg-info">@selectedDetection.DetectedObject</span></p>
                            <p><strong>Confidence:</strong> <span class="badge bg-success">@selectedDetection.Confidence.ToString("F1")%</span></p>
                            <p><strong>Device ID:</strong> <span class="badge bg-warning text-dark">@selectedDetection.DeviceId</span></p>
                        </div>
                        <div class="col-md-6">
                            @if (selectedDetection.MediaId.HasValue)
                            {
                                <p><strong>Media ID:</strong> @selectedDetection.MediaId</p>
                            }
                            @if (selectedDetection.TrackingId.HasValue)
                            {
                                <p><strong>Tracking ID:</strong> @selectedDetection.TrackingId</p>
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // State
    private List<Detection>? detections = null;
    private List<Detection> filteredDetections = new();
    private bool isLoading = false;
    private string? errorMessage = null;
    private Detection? selectedDetection = null;

    // Filters
    private DateTime dateFrom = DateTime.Today.AddDays(-7);
    private DateTime dateTo = DateTime.Today;
    private string filterObject = "";

    // Available objects for dropdown
    private List<string> availableObjects = new();

    // Lifecycle
    protected override async Task OnInitializedAsync()
    {
        await LoadDetections();
    }

    // Load detections from API
    private async Task LoadDetections()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            // Format dates as strings
            var fromStr = dateFrom.ToString("yyyy-MM-dd");
            var toStr = dateTo.ToString("yyyy-MM-dd");
            var url = $"api/detection?from={fromStr}&to={toStr}";

            Logger.LogInformation("Fetching detections from: {Url}", url);

            var response = await Http.GetAsync(url);

            if (response.IsSuccessStatusCode)
            {
                detections = await response.Content.ReadFromJsonAsync<List<Detection>>();
                Logger.LogInformation("Loaded {Count} detections", detections?.Count ?? 0);

                // Extract unique objects for filter dropdown
                if (detections != null)
                {
                    availableObjects = detections
                        .Where(d => !string.IsNullOrEmpty(d.DetectedObject))
                        .Select(d => d.DetectedObject!)
                        .Distinct()
                        .OrderBy(o => o)
                        .ToList();
                }

                ApplyFilters();
            }
            else
            {
                errorMessage = $"Failed to load detections: {response.StatusCode}";
                Logger.LogError("API error: {Status}", response.StatusCode);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
            Logger.LogError(ex, "Exception loading detections");
        }
        finally
        {
            isLoading = false;
        }
    }

    // Apply client-side filters
    private void ApplyFilters()
    {
        if (detections == null)
        {
            filteredDetections = new();
            return;
        }

        filteredDetections = detections
            .Where(d => string.IsNullOrEmpty(filterObject) || d.DetectedObject == filterObject)
            .OrderByDescending(d => d.DetectedAt)
            .ToList();
    }

    // Clear all filters
    private async Task ClearFilters()
    {
        dateFrom = DateTime.Today.AddDays(-7);
        dateTo = DateTime.Today;
        filterObject = "";
        await LoadDetections();
    }

    // Show detection details
    private void ShowDetails(Detection detection)
    {
        selectedDetection = detection;
    }

    // Close modal
    private void CloseModal()
    {
        selectedDetection = null;
    }

    // Get confidence color
    private string GetConfidenceColorClass(float confidence)
    {
        if (confidence >= 80) return "bg-success";
        if (confidence >= 60) return "bg-warning";
        return "bg-danger";
    }

    // Detection Model
    public class Detection
    {
        public int DetectionId { get; set; }
        public DateTime DetectedAt { get; set; }
        public string? DetectedObject { get; set; }
        public float Confidence { get; set; }
        public int DeviceId { get; set; }
        public int? MediaId { get; set; }
        public int? TrackingId { get; set; }
    }
}