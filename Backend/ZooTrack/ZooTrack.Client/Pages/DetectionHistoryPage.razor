@code {
    private List<DetectionRecord>? allDetections;
    private List<DetectionRecord> filteredDetections = new();
    private List<DetectionRecord> currentPageDetections = new();
    private List<string>? targetAnimals;
    private bool isLoading = false;
    private string? errorMessage;
    private string selectedAnimalType = "";
    private string selectedDevice = "";
    private DateOnly? dateFrom;
    private DateOnly? dateTo;
    private DetectionRecord? selectedDetection;
    private bool showDeleteModal = false;
    private DetectionRecord? detectionToDelete;

    // Pagination
    private int currentPage = 1;
    private int pageSize = 50;
    private int totalPages = 1;
    private int totalDetections = 0;

    // Sorting
    private string currentSortField = nameof(DetectionRecord.DetectedAt);
    private bool sortDescending = true;

    // Helper method to normalize confidence values
    private double GetNormalizedConfidence(float confidence)
    {
        // If confidence is already between 0-1, convert to percentage
        if (confidence <= 1.0f)
            return confidence * 100;

        // If confidence is already a percentage (0-100), return as is
        if (confidence <= 100)
            return confidence;

        // If confidence is greater than 100, assume it's been multiplied by 100 incorrectly
        // and divide by 100 to get back to 0-100 range
        return Math.Min(confidence / 100, 100);
    }

    // CRUD: delete
    private async Task DeleteDetection(DetectionRecord detection)
    {
        if (detection == null) return;

        try
        {
            var response = await Http.DeleteAsync($"api/detection/{detection.DetectionId}");

            if (response.IsSuccessStatusCode)
            {
                // delete locally
                allDetections?.Remove(detection);
                filteredDetections.Remove(detection);

                ApplyFiltersAndPagination(); // refresh

                Logger.LogInformation("Successfully deleted detection {Id}", detection.DetectionId);

                showDeleteModal = false;
                detectionToDelete = null;

                StateHasChanged();
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Failed to delete detection: {response.StatusCode}";
                Logger.LogError("Failed to delete detection {Id}: {StatusCode} - {Error}",
                    detection.DetectionId, response.StatusCode, errorContent);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting detection: {ex.Message}";
            Logger.LogError(ex, "Exception while deleting detection {Id}", detection.DetectionId);
        }
    }

    private void ShowDeleteConfirmation(DetectionRecord detection)
    {
        detectionToDelete = detection;
        showDeleteModal = true;
        StateHasChanged();
    }

    private void CancelDelete()
    {
        showDeleteModal = false;
        detectionToDelete = null;
        StateHasChanged();
    }

    private async Task ConfirmDelete()
    {
        if (detectionToDelete != null)
        {
            await DeleteDetection(detectionToDelete);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Set default date range to last 7 days
        dateTo = DateOnly.FromDateTime(DateTime.Today);
        dateFrom = DateOnly.FromDateTime(DateTime.Today.AddDays(-7));

        await LoadTargetAnimals();
        await LoadDetections();
    }

    private async Task LoadTargetAnimals()
    {
        try
        {
            var response = await Http.GetAsync("Data/TargetAnimals.json");
            if (response.IsSuccessStatusCode)
            {
                var jsonContent = await response.Content.ReadAsStringAsync();
                targetAnimals = JsonSerializer.Deserialize<List<string>>(jsonContent, new JsonSerializerOptions
                    {
                        PropertyNameCaseInsensitive = true
                    });

                Logger.LogInformation("Successfully loaded {Count} target animals", targetAnimals?.Count ?? 0);
            }
            else
            {
                Logger.LogWarning("Failed to load target animals file: {StatusCode}", response.StatusCode);
                // Fallback to default animals if file not found
                targetAnimals = new List<string> { "giraffe", "sheep", "dog", "cow", "wolf", "zebra", "tiger", "lion", "person", "other" };
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading target animals");
            // Fallback to default animals
            targetAnimals = new List<string> { "giraffe", "sheep", "dog", "cow", "wolf", "zebra", "tiger", "lion", "person", "other" };
        }
    }

    private string CapitalizeFirstLetter(string input)
    {
        if (string.IsNullOrEmpty(input)) return input;
        return char.ToUpper(input[0]) + input.Substring(1).ToLower();
    }

    private async Task LoadDetections()
    {
        isLoading = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            var queryParams = new List<string>();

            if (dateFrom.HasValue)
                queryParams.Add($"from={dateFrom.Value:yyyy-MM-dd}");

            if (dateTo.HasValue)
                queryParams.Add($"to={dateTo.Value:yyyy-MM-dd}");

            var queryString = queryParams.Count > 0 ? "?" + string.Join("&", queryParams) : "";

            Logger.LogInformation("Loading detections with query: {Query}", queryString);

            var response = await Http.GetAsync($"api/detection{queryString}");

            if (response.IsSuccessStatusCode)
            {
                var jsonContent = await response.Content.ReadAsStringAsync();
                allDetections = JsonSerializer.Deserialize<List<DetectionRecord>>(jsonContent, new JsonSerializerOptions
                    {
                        PropertyNameCaseInsensitive = true
                    });

                totalDetections = allDetections?.Count ?? 0;
                ApplyFiltersAndPagination();

                Logger.LogInformation("Successfully loaded {Count} detections", allDetections?.Count ?? 0);
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Failed to load detections: {response.StatusCode}";
                Logger.LogError("Failed to load detections: {StatusCode} - {Error}", response.StatusCode, errorContent);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading detections: {ex.Message}";
            Logger.LogError(ex, "Exception while loading detections");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ApplyFiltersAndPagination()
    {
        if (allDetections == null)
        {
            filteredDetections = new();
            currentPageDetections = new();
            return;
        }

        // Apply filters
        filteredDetections = allDetections.Where(d =>
            (string.IsNullOrEmpty(selectedAnimalType) || (d.DetectedObject?.Equals(selectedAnimalType, StringComparison.OrdinalIgnoreCase) ?? false)) &&
            (string.IsNullOrEmpty(selectedDevice) || d.DeviceId.ToString() == selectedDevice)
        ).ToList();

        // Apply sorting
        filteredDetections = GetSortedDetections().ToList();

        // Calculate pagination
        totalPages = (int)Math.Ceiling((double)filteredDetections.Count / pageSize);
        if (currentPage > totalPages) currentPage = Math.Max(1, totalPages);

        // Get current page data
        var skip = (currentPage - 1) * pageSize;
        currentPageDetections = filteredDetections.Skip(skip).Take(pageSize).ToList();
    }

    private async Task ClearFilters()
    {
        selectedAnimalType = "";
        selectedDevice = "";
        dateFrom = DateOnly.FromDateTime(DateTime.Today.AddDays(-7));
        dateTo = DateOnly.FromDateTime(DateTime.Today);
        currentPage = 1;
        await LoadDetections();
    }

    private void SortTable(string fieldName)
    {
        if (currentSortField == fieldName)
        {
            sortDescending = !sortDescending;
        }
        else
        {
            currentSortField = fieldName;
            sortDescending = true;
        }
        currentPage = 1; // Reset to first page when sorting
        ApplyFiltersAndPagination();
    }

    private IEnumerable<DetectionRecord> GetSortedDetections()
    {
        if (filteredDetections == null) return new List<DetectionRecord>();

        return currentSortField switch
        {
            nameof(DetectionRecord.DetectionId) => sortDescending
                ? filteredDetections.OrderByDescending(d => d.DetectionId)
                : filteredDetections.OrderBy(d => d.DetectionId),
            nameof(DetectionRecord.DetectedAt) => sortDescending
                ? filteredDetections.OrderByDescending(d => d.DetectedAt)
                : filteredDetections.OrderBy(d => d.DetectedAt),
            nameof(DetectionRecord.DetectedObject) => sortDescending
                ? filteredDetections.OrderByDescending(d => d.DetectedObject)
                : filteredDetections.OrderBy(d => d.DetectedObject),
            nameof(DetectionRecord.DeviceId) => sortDescending
                ? filteredDetections.OrderByDescending(d => d.DeviceId)
                : filteredDetections.OrderBy(d => d.DeviceId),
            nameof(DetectionRecord.TrackingId) => sortDescending
                ? filteredDetections.OrderByDescending(d => d.TrackingId)
                : filteredDetections.OrderBy(d => d.TrackingId),
            nameof(DetectionRecord.Confidence) => sortDescending
                ? filteredDetections.OrderByDescending(d => d.Confidence)
                : filteredDetections.OrderBy(d => d.Confidence),
            _ => filteredDetections.OrderByDescending(d => d.DetectedAt)
        };
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            ApplyFiltersAndPagination();
        }
    }

