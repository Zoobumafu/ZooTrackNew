@page "/detections"
@inject HttpClient Http
@inject ILogger<DetectionHistoryPage> Logger
@using System.Text.Json

<PageTitle>Detection History - ZooTrack</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h2 class="mb-2">
                <i class="bi bi-search me-2 text-primary"></i>
                Detection History
            </h2>
            <p class="text-muted">Browse and manage animal detection records</p>
        </div>
    </div>

    <!-- Filters Section -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-light">
            <h5 class="mb-0">
                <i class="bi bi-funnel me-2"></i>
                Filters
            </h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label for="animalType" class="form-label">Animal Type:</label>
                    <select class="form-select" id="animalType" @bind="selectedAnimalType" @bind:after="LoadDetections">
                        <option value="">All Animals</option>
                        @if (targetAnimals != null)
                        {
                            @foreach (var animal in targetAnimals)
                            {
                                <option value="@animal">@CapitalizeFirstLetter(animal)</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="deviceId" class="form-label">Device:</label>
                    <select class="form-select" id="deviceId" @bind="selectedDevice" @bind:after="LoadDetections">
                        <option value="">All Devices</option>
                        <option value="1">Device 1</option>
                        <option value="2">Device 2</option>
                        <option value="3">Device 3</option>
                        <option value="4">Device 4</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="dateFrom" class="form-label">From Date:</label>
                    <input type="date" class="form-control" id="dateFrom" @bind="dateFrom" @bind:after="LoadDetections" />
                </div>
                <div class="col-md-2">
                    <label for="dateTo" class="form-label">To Date:</label>
                    <input type="date" class="form-control" id="dateTo" @bind="dateTo" @bind:after="LoadDetections" />
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button class="btn btn-primary me-2" @onclick="LoadDetections" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        }
                        <i class="bi bi-arrow-clockwise me-1"></i>
                        Refresh
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="ClearFilters">
                        <i class="bi bi-x-circle me-1"></i>
                        Clear
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Error Message -->
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <!-- Loading State -->
    @if (isLoading && allDetections == null)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status">
                <span class="visually-hidden">Loading detections...</span>
            </div>
            <p class="text-muted">Loading detection records...</p>
        </div>
    }
    else if (allDetections != null)
    {
        <!-- Results Summary -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <span class="badge bg-primary fs-6">
                    @filteredDetections.Count Detection@(filteredDetections.Count != 1 ? "s" : "") Found
                    @if (totalDetections > filteredDetections.Count)
                    {
                        <text> (of @totalDetections total)</text>
                    }
                </span>
            </div>
            <small class="text-muted">
                <i class="bi bi-clock me-1"></i>
                Last updated: @DateTime.Now.ToString("HH:mm:ss")
            </small>
        </div>

        <!-- Detections Table -->
        <div class="card shadow-sm">
            <div class="card-body p-0">
                @if (currentPageDetections.Count == 0)
                {
                    <div class="text-center py-5">
                        <i class="bi bi-search display-1 text-muted mb-3"></i>
                        <h5 class="text-muted">No detections found</h5>
                        <p class="text-muted">Try adjusting your filter criteria</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover table-striped mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th scope="col">
                                        <button class="btn btn-sm btn-link text-white p-0 text-decoration-none" @onclick="() => SortTable(nameof(DetectionRecord.DetectionId))">
                                            Detection ID
                                            <i class="bi bi-arrow-down-up ms-1"></i>
                                        </button>
                                    </th>
                                    <th scope="col">
                                        <button class="btn btn-sm btn-link text-white p-0 text-decoration-none" @onclick="() => SortTable(nameof(DetectionRecord.DetectedAt))">
                                            Date
                                            <i class="bi bi-arrow-down-up ms-1"></i>
                                        </button>
                                    </th>
                                    <th scope="col">Time</th>
                                    <th scope="col">
                                        <button class="btn btn-sm btn-link text-white p-0 text-decoration-none" @onclick="() => SortTable(nameof(DetectionRecord.DetectedObject))">
                                            Detected Object
                                            <i class="bi bi-arrow-down-up ms-1"></i>
                                        </button>
                                    </th>
                                    <th scope="col">
                                        <button class="btn btn-sm btn-link text-white p-0 text-decoration-none" @onclick="() => SortTable(nameof(DetectionRecord.DeviceId))">
                                            Device ID
                                            <i class="bi bi-arrow-down-up ms-1"></i>
                                        </button>
                                    </th>
                                    <th scope="col">
                                        <button class="btn btn-sm btn-link text-white p-0 text-decoration-none" @onclick="() => SortTable(nameof(DetectionRecord.TrackingId))">
                                            Tracking ID
                                            <i class="bi bi-arrow-down-up ms-1"></i>
                                        </button>
                                    </th>
                                    <th scope="col">
                                        <button class="btn btn-sm btn-link text-white p-0 text-decoration-none" @onclick="() => SortTable(nameof(DetectionRecord.Confidence))">
                                            Confidence
                                            <i class="bi bi-arrow-down-up ms-1"></i>
                                        </button>
                                    </th>
                                    <th scope="col">Media ID</th>
                                    <th scope="col" style="width: 120px;">Thumbnail</th>
                                    <th scope="col" style="width: 140px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var detection in currentPageDetections)
                                {
                                    <tr>
                                        <td>
                                            <span class="badge bg-secondary">#@detection.DetectionId</span>
                                        </td>
                                        <td>
                                            <strong>@detection.DetectedAt.ToString("MMM dd, yyyy")</strong>
                                        </td>
                                        <td>
                                            <span class="text-muted">@detection.DetectedAt.ToString("HH:mm:ss")</span>
                                        </td>
                                        <td>
                                            <span class="badge @GetAnimalBadgeClass(detection.DetectedObject) fs-6">
                                                @CapitalizeFirstLetter(detection.DetectedObject ?? "Unknown")
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge bg-info text-dark">@detection.DeviceId</span>
                                        </td>
                                        <td>
                                            @if (detection.TrackingId.HasValue)
                                            {
                                                <span class="badge bg-warning text-dark">#@detection.TrackingId</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">N/A</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="progress me-2" style="width: 60px; height: 8px;">
                                                    <div class="progress-bar @GetConfidenceColor(detection.Confidence)" style="width: @GetNormalizedConfidence(detection.Confidence)%"></div>
                                                </div>
                                                <small class="text-muted">@GetNormalizedConfidence(detection.Confidence).ToString("F1")%</small>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="text-muted">#@detection.MediaId</span>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(detection.ImagePath))
                                            {
                                                <img src="@detection.ImagePath" alt="Detection thumbnail" class="thumbnail-image" @onclick="() => ShowImageModal(detection)" title="Click to view full image" />
                                            }
                                            else
                                            {
                                                <div class="thumbnail-placeholder">
                                                    <i class="bi bi-image text-muted"></i>
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-outline-primary" @onclick="() => ShowDetails(detection)" title="View Details">
                                                    <i class="bi bi-eye"></i>
                                                </button>
                                                <button class="btn btn-outline-success" @onclick="() => DownloadImage(detection)" disabled="@string.IsNullOrEmpty(detection.ImagePath)" title="Download Image">
                                                    <i class="bi bi-download"></i>
                                                </button>
                                                <button class="btn btn-outline-danger" @onclick="() => ShowDeleteConfirmation(detection)" title="Delete Detection">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- Pagination -->
        @if (filteredDetections.Count > 0)
        {
            <div class="d-flex justify-content-between align-items-center mt-4">
                <div>
                    <small class="text-muted">
                        Showing @((currentPage - 1) * pageSize + 1) - @Math.Min(currentPage * pageSize, filteredDetections.Count) of @filteredDetections.Count detection@(filteredDetections.Count != 1 ? "s" : "")
                    </small>
                </div>

                @if (totalPages > 1)
                {
                    <nav aria-label="Page navigation">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <button class="page-link" @onclick="() => GoToPage(1)" disabled="@(currentPage == 1)">
                                    <i class="bi bi-chevron-double-left"></i>
                                </button>
                            </li>
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <button class="page-link" @onclick="() => GoToPage(currentPage - 1)" disabled="@(currentPage == 1)">
                                    <i class="bi bi-chevron-left"></i>
                                </button>
                            </li>

                            @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                            {
                                var pageNumber = i;
                                <li class="page-item @(currentPage == pageNumber ? "active" : "")">
                                    <button class="page-link" @onclick="() => GoToPage(pageNumber)">@pageNumber</button>
                                </li>
                            }

                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <button class="page-link" @onclick="() => GoToPage(currentPage + 1)" disabled="@(currentPage == totalPages)">
                                    <i class="bi bi-chevron-right"></i>
                                </button>
                            </li>
                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <button class="page-link" @onclick="() => GoToPage(totalPages)" disabled="@(currentPage == totalPages)">
                                    <i class="bi bi-chevron-double-right"></i>
                                </button>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        }
    }
</div>

<!-- Image Modal -->
@if (selectedDetection != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-@GetAnimalIcon(selectedDetection.DetectedObject ?? "unknown") me-2 text-primary"></i>
                        @CapitalizeFirstLetter(selectedDetection.DetectedObject ?? "Unknown") Detection
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseImageModal"></button>
                </div>
                <div class="modal-body">
                    <div class="text-center mb-3">
                        <img src="@selectedDetection.ImagePath" alt="Detection of @selectedDetection.DetectedObject" class="img-fluid rounded shadow" style="max-height: 60vh;" />
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <h6 class="mb-2">Detection Details</h6>
                            <ul class="list-unstyled">
                                <li><strong>Detection ID:</strong> #@selectedDetection.DetectionId</li>
                                <li><strong>Date & Time:</strong> @selectedDetection.DetectedAt.ToString("MMM dd, yyyy HH:mm:ss")</li>
                                <li><strong>Device:</strong> @selectedDetection.DeviceId</li>
                                <li><strong>Media ID:</strong> @selectedDetection.MediaId</li>
                                @if (selectedDetection.TrackingId.HasValue)
                                {
                                    <li><strong>Tracking ID:</strong> #@selectedDetection.TrackingId</li>
                                }
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h6 class="mb-2">Detection Metrics</h6>
                            <ul class="list-unstyled">
                                <li><strong>Confidence:</strong> @GetNormalizedConfidence(selectedDetection.Confidence).ToString("F1")%</li>
                                <li><strong>Processing Time:</strong> @selectedDetection.ProcessingTimeMs ms</li>
                                <li><strong>Frame Number:</strong> @selectedDetection.FrameNumber</li>
                                <li>
                                    <strong>Alert Status:</strong>
                                    @if (selectedDetection.AlertTriggered)
                                    {
                                        <span class="badge bg-warning text-dark">Alert Triggered</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Normal</span>
                                    }
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary" @onclick="() => DownloadImage(selectedDetection)">
                        <i class="bi bi-download me-1"></i>Download Image
                    </button>
                    <button class="btn btn-secondary" @onclick="CloseImageModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
@if (showDeleteModal && detectionToDelete != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-exclamation-triangle-fill me-2 text-warning"></i>
                        Confirm Deletion
                    </h5>
                    <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete this detection record?</p>
                    <div class="alert alert-light border">
                        <div class="row">
                            <div class="col-md-8">
                                <strong>Detection ID:</strong> #@detectionToDelete.DetectionId<br>
                                <strong>Animal:</strong> @CapitalizeFirstLetter(detectionToDelete.DetectedObject ?? "Unknown")<br>
                                <strong>Date:</strong> @detectionToDelete.DetectedAt.ToString("MMM dd, yyyy HH:mm:ss")<br>
                                <strong>Device:</strong> @detectionToDelete.DeviceId
                            </div>
                            @if (!string.IsNullOrEmpty(detectionToDelete.ImagePath))
                            {
                                <div class="col-md-4 text-end">
                                    <img src="@detectionToDelete.ImagePath" alt="Detection thumbnail" class="img-thumbnail" style="max-width: 80px; max-height: 60px;" />
                                </div>
                            }
                        </div>
                    </div>
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        <strong>Warning:</strong> This action cannot be undone.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CancelDelete">
                        <i class="bi bi-x-circle me-1"></i>Cancel
                    </button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">
                        <i class="bi bi-trash me-1"></i>Delete Detection
                    </button>
                </div>
            </div>
        </div>
    </div>
}

