    private string GetAnimalBadgeClass(string? animalType)
    {
        return animalType?.ToLower() switch
        {
            "lion" => "bg-warning text-dark",
            "tiger" => "bg-warning text-dark",
            "person" or "man" => "bg-danger",
            "giraffe" => "bg-info text-dark",
            "zebra" => "bg-dark",
            "sheep" => "bg-light text-dark",
            "dog" => "bg-success",
            "cow" => "bg-secondary",
            "wolf" => "bg-dark",
            _ => "bg-primary"
        };
    }

    private string GetAnimalIcon(string? animalType)
    {
        return animalType?.ToLower() switch
        {
            "lion" or "tiger" => "star-fill",
            "person" or "man" => "person-fill",
            "giraffe" => "triangle-fill",
            "zebra" => "square-fill",
            "sheep" => "circle-fill",
            "dog" => "heart-fill",
            "cow" => "square-fill",
            "wolf" => "diamond-fill",
            _ => "question-circle-fill"
        };
    }

    private string GetConfidenceColor(float confidence)
    {
        var normalizedConfidence = GetNormalizedConfidence(confidence);
        return normalizedConfidence switch
        {
            >= 80 => "bg-success",
            >= 60 => "bg-warning",
            _ => "bg-danger"
        };
    }

