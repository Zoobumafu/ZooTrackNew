@page "/statistics"
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<PageTitle>Detection Statistics</PageTitle>

<div class="min-h-screen bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-100">
    <div class="container mx-auto px-4 py-8">
        <!-- Page Header -->
        <div class="text-center mb-8">
            <h1 class="text-4xl font-bold text-gray-800 mb-2">Detection Statistics</h1>
            <p class="text-gray-600 text-lg">Monitor and analyze detection patterns across your surveillance network</p>
        </div>

        <!-- Filter Controls -->
        <div class="bg-white rounded-2xl shadow-lg p-6 mb-8 border border-gray-100">
            <div class="flex items-center mb-4">
                <div class="bg-blue-500 w-1 h-6 rounded mr-3"></div>
                <h2 class="text-xl font-semibold text-gray-800">Filters & Controls</h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="space-y-2">
                    <label for="cameraSelect" class="block text-sm font-medium text-gray-700">Select Camera</label>
                    <select id="cameraSelect" @bind="SelectedCameraId" @bind:after="LoadStatistics"
                            class="w-full px-4 py-3 text-base border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-white shadow-sm">
                        <option value="0">🎥 All Cameras</option>
                        @foreach (var camera in Cameras)
                        {
                            <option value="@camera.DeviceId">📍 @camera.Location (@camera.DeviceId)</option>
                        }
                    </select>
                </div>
                <div class="space-y-2">
                    <label for="startDate" class="block text-sm font-medium text-gray-700">Start Date</label>
                    <input type="date" id="startDate" @bind="StartDate" @bind:after="LoadStatistics"
                           class="w-full px-4 py-3 text-base border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-white shadow-sm" />
                </div>
                <div class="space-y-2">
                    <label for="endDate" class="block text-sm font-medium text-gray-700">End Date</label>
                    <input type="date" id="endDate" @bind="EndDate" @bind:after="LoadStatistics"
                           class="w-full px-4 py-3 text-base border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-white shadow-sm" />
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-8">
            <!-- Summary Statistics Cards -->
            <div class="lg:col-span-1 space-y-6">
                <div class="bg-white rounded-2xl shadow-lg p-6 border border-gray-100">
                    <div class="flex items-center mb-4">
                        <div class="bg-green-500 w-1 h-6 rounded mr-3"></div>
                        <h2 class="text-xl font-semibold text-gray-800">Detection Summary</h2>
                    </div>
                    @if (SummaryStatistics != null)
                    {
                        <div class="space-y-4">
                            <div class="bg-green-50 p-4 rounded-lg border border-green-200">
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center">
                                        <div class="w-3 h-3 bg-green-500 rounded-full mr-2"></div>
                                        <span class="text-gray-700 font-medium">True Positives</span>
                                    </div>
                                    <span class="text-2xl font-bold text-green-600">@SummaryStatistics.TruePositives</span>
                                </div>
                            </div>
                            <div class="bg-red-50 p-4 rounded-lg border border-red-200">
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center">
                                        <div class="w-3 h-3 bg-red-500 rounded-full mr-2"></div>
                                        <span class="text-gray-700 font-medium">False Positives</span>
                                    </div>
                                    <span class="text-2xl font-bold text-red-600">@SummaryStatistics.FalsePositives</span>
                                </div>
                            </div>
                            <div class="bg-orange-50 p-4 rounded-lg border border-orange-200">
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center">
                                        <div class="w-3 h-3 bg-orange-500 rounded-full mr-2"></div>
                                        <span class="text-gray-700 font-medium">False Negatives</span>
                                    </div>
                                    <span class="text-2xl font-bold text-orange-600">@SummaryStatistics.FalseNegatives</span>
                                </div>
                            </div>
                            <!-- Accuracy Calculation -->
                            @{
                                var total = SummaryStatistics.TruePositives + SummaryStatistics.FalsePositives + SummaryStatistics.FalseNegatives;
                                var accuracy = total > 0 ? Math.Round((double)SummaryStatistics.TruePositives / total * 100, 1) : 0;
                            }
                            <div class="bg-blue-50 p-4 rounded-lg border border-blue-200">
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center">
                                        <div class="w-3 h-3 bg-blue-500 rounded-full mr-2"></div>
                                        <span class="text-gray-700 font-medium">Accuracy</span>
                                    </div>
                                    <span class="text-2xl font-bold text-blue-600">@accuracy%</span>
                                </div>
                            </div>
                        </div>
                    }
                    else if (IsLoadingSummary)
                    {
                        <div class="flex items-center justify-center py-8">
                            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-500"></div>
                            <span class="ml-3 text-gray-600">Loading summary...</span>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-8">
                            <div class="text-gray-400 text-4xl mb-2">📊</div>
                            <p class="text-gray-500">No summary data available</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Heatmap Section with Large Aerial Image -->
            <div class="lg:col-span-2">
                <div class="bg-white rounded-2xl shadow-lg p-6 border border-gray-100">
                    <div class="flex items-center justify-between mb-4">
                        <div class="flex items-center">
                            <div class="bg-purple-500 w-1 h-6 rounded mr-3"></div>
                            <h2 class="text-xl font-semibold text-gray-800">Detection Heatmap - Aerial View</h2>
                        </div>
                        <!-- Control Buttons -->
                        @if (SelectedCameraId != 0)
                        {
                            <div class="flex gap-2">
                                <button @onclick="ToggleImageSize"
                                        class="px-4 py-2 bg-blue-500 hover:bg-blue-600 text-white text-sm font-medium rounded-lg shadow-sm transition-all duration-200 hover:shadow-md">
                                    @(IsImageExpanded ? "🔍 Fit View" : "🔍 Full Size")
                                </button>
                                <button @onclick="ClearHeatmap"
                                        class="px-4 py-2 bg-red-500 hover:bg-red-600 text-white text-sm font-medium rounded-lg shadow-sm transition-all duration-200 hover:shadow-md">
                                    🗑️ Clear
                                </button>
                            </div>
                        }
                    </div>

                    @if (SelectedCameraId != 0 && !IsLoadingHeatmap)
                    {
                        <div class="relative bg-gray-50 rounded-xl overflow-hidden border-2 border-gray-200 shadow-inner">
                            <!-- Aerial Image Display -->
                            <img id="aerialImage"
                                 src="Images/aerial-view.png"
                                 alt="Aerial View of Monitoring Area"
                                 class="w-full h-auto max-h-[600px] object-contain rounded-lg"
                                 style="display: block; margin: 0 auto;"
                                 @onerror="HandleImageError" />
                            <canvas id="heatmapCanvas" class="absolute top-0 left-0 w-full h-full pointer-events-none"></canvas>

                            <!-- Status Overlay -->
                            @if (HeatmapData == null || !HeatmapData.Any())
                            {
                                <div class="absolute bottom-4 left-4 right-4">
                                    <div class="bg-yellow-100 border border-yellow-300 text-yellow-800 px-4 py-2 rounded-lg text-sm">
                                        ⚠️ No heatmap data available for the selected filters
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="absolute bottom-4 left-4 right-4">
                                    <div class="bg-green-100 border border-green-300 text-green-800 px-4 py-2 rounded-lg text-sm">
                                         Showing @HeatmapData.Count detection points on the aerial view
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else if (IsLoadingHeatmap)
                    {
                        <div class="bg-gray-50 rounded-xl p-12 text-center border-2 border-gray-200">
                            <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-500 mx-auto mb-4"></div>
                            <p class="text-gray-600">Loading heatmap data...</p>
                        </div>
                    }
                    else
                    {
                        <!-- Show the aerial image even when no camera is selected -->
                        <div class="relative bg-gray-50 rounded-xl overflow-hidden border-2 border-gray-200">
                            <img id="aerialImageDefault"
                                 src="Images/aerial-view.png"
                                 alt="Aerial View of Monitoring Area"
                                 class="w-full h-auto max-h-[500px] object-contain rounded-lg opacity-60"
                                 style="display: block; margin: 0 auto;"
                                 @onerror="HandleImageError" />
                            <div class="absolute inset-0 flex items-center justify-center">
                                <div class="bg-white bg-opacity-95 backdrop-blur-sm px-8 py-6 rounded-xl shadow-lg text-center border border-gray-200">
                                    <div class="text-4xl mb-3">🎯</div>
                                    <h3 class="text-lg font-semibold text-gray-800 mb-2">Select a Camera</h3>
                                    <p class="text-gray-600">Choose a specific camera to view its detection heatmap overlay</p>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Legend -->
                    <div class="mt-4 p-4 bg-gray-50 rounded-lg border border-gray-200">
                        <h4 class="text-sm font-semibold text-gray-700 mb-2">Legend</h4>
                        <div class="flex flex-wrap gap-4 text-xs">
                            <div class="flex items-center">
                                <div class="w-4 h-2 bg-red-400 rounded mr-2 opacity-60"></div>
                                <span class="text-gray-600">Detection Areas</span>
                            </div>
                            <div class="flex items-center">
                                <div class="w-4 h-2 bg-blue-400 rounded mr-2"></div>
                                <span class="text-gray-600">Movement Paths</span>
                            </div>
                            <div class="flex items-center">
                                <div class="w-2 h-2 bg-blue-600 rounded-full mr-2"></div>
                                <span class="text-gray-600">Start Points</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private SummaryStatisticsResponse? SummaryStatistics;
    private List<HeatmapDetectionData>? HeatmapData;
    private List<Device> Cameras = new List<Device>();
    private int SelectedCameraId = 0;
    private DateTime StartDate = DateTime.Today.AddMonths(-1);
    private DateTime EndDate = DateTime.Today;

    private bool IsLoadingSummary = false;
    private bool IsLoadingHeatmap = false;
    private bool IsImageExpanded = false;
    private bool ImageLoadError = false;

    private List<TrackingRouteData>? RouteData;

    private class TrackingRouteData
    {
        public int TrackingId { get; set; }
        public string? DetectedObject { get; set; }
        public DateTime StartTime { get; set; }
        public DateTime EndTime { get; set; }
        public string PathJson { get; set; } = "";
    }

    private class SummaryStatisticsResponse
    {
        public int TruePositives { get; set; }
        public int FalsePositives { get; set; }
        public int FalseNegatives { get; set; }
    }

    private class HeatmapDetectionData
    {
        public float BoundingBoxX { get; set; }
        public float BoundingBoxY { get; set; }
        public float BoundingBoxWidth { get; set; }
        public float BoundingBoxHeight { get; set; }
        public float Confidence { get; set; }
        public DateTime DetectedAt { get; set; }
    }

    private class Device
    {
        public int DeviceId { get; set; }
        public string Location { get; set; } = string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadCameras();
        await LoadStatistics();
    }

    private async Task LoadCameras()
    {
        try
        {
            Cameras = await Http.GetFromJsonAsync<List<Device>>("api/device/list") ?? new List<Device>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading cameras: {ex.Message}");
        }
    }

    private async Task LoadStatistics()
    {
        await LoadRouteData(SelectedCameraId);
        await LoadSummaryStatistics();
        if (SelectedCameraId != 0)
        {
            await LoadHeatmapData(SelectedCameraId);
        }
        else
        {
            HeatmapData = null;
            await JSRuntime.InvokeVoidAsync("clearHeatmap");
        }
    }

    private async Task LoadRouteData(int cameraId)
    {
        try
        {
            var url = $"api/statistics/routes/{cameraId}";
            var queryParams = new List<string>();

            if (StartDate != default)
                queryParams.Add($"startDate={StartDate:yyyy-MM-dd}");

            if (EndDate != default)
                queryParams.Add($"endDate={EndDate:yyyy-MM-dd}");

            if (queryParams.Any())
                url += "?" + string.Join("&", queryParams);

            RouteData = await Http.GetFromJsonAsync<List<TrackingRouteData>>(url);

            if (RouteData is not null)
            {
                await JSRuntime.InvokeVoidAsync("drawRoutes", RouteData);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading tracking routes: {ex.Message}");
            RouteData = null;
        }
    }

    private async Task LoadSummaryStatistics()
    {
        IsLoadingSummary = true;
        try
        {
            var url = $"api/statistics/summary";
            var queryParams = new List<string>();

            if (SelectedCameraId != 0)
            {
                queryParams.Add($"deviceId={SelectedCameraId}");
            }
            if (StartDate != default(DateTime))
            {
                queryParams.Add($"startDate={StartDate:yyyy-MM-dd}");
            }
            if (EndDate != default(DateTime))
            {
                queryParams.Add($"endDate={EndDate:yyyy-MM-dd}");
            }

            if (queryParams.Any())
            {
                url += "?" + string.Join("&", queryParams);
            }

            SummaryStatistics = await Http.GetFromJsonAsync<SummaryStatisticsResponse>(url);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching summary statistics: {ex.Message}");
            SummaryStatistics = null;
        }
        finally
        {
            IsLoadingSummary = false;
        }
    }

    private async Task LoadHeatmapData(int cameraId)
    {
        IsLoadingHeatmap = true;
        try
        {
            var url = $"api/statistics/heatmap/{cameraId}";
            var queryParams = new List<string>();

            if (StartDate != default(DateTime))
            {
                queryParams.Add($"startDate={StartDate:yyyy-MM-dd}");
            }
            if (EndDate != default(DateTime))
            {
                queryParams.Add($"endDate={EndDate:yyyy-MM-dd}");
            }

            if (queryParams.Any())
            {
                url += "?" + string.Join("&", queryParams);
            }

            HeatmapData = await Http.GetFromJsonAsync<List<HeatmapDetectionData>>(url);
            if (HeatmapData != null)
            {
                await JSRuntime.InvokeVoidAsync("drawHeatmap", HeatmapData);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching heatmap data: {ex.Message}");
            HeatmapData = null;
        }
        finally
        {
            IsLoadingHeatmap = false;
        }
    }

    private async Task ToggleImageSize()
    {
        IsImageExpanded = !IsImageExpanded;
        await JSRuntime.InvokeVoidAsync("toggleImageSize", IsImageExpanded);
    }

    private async Task ClearHeatmap()
    {
        await JSRuntime.InvokeVoidAsync("clearHeatmap");
    }

    private async Task HandleImageError()
    {
        ImageLoadError = true;
        await JSRuntime.InvokeVoidAsync("console.log", "Image failed to load. Check if the file exists at: Images/aerial-view.png");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("eval", @"
                window.drawHeatmap = function(detectionData) {
                    const canvas = document.getElementById('heatmapCanvas');
                    if (!canvas) {
                        console.error('Heatmap canvas not found.');
                        return;
                    }
                    const ctx = canvas.getContext('2d');
                    const img = canvas.previousElementSibling;

                    if (img && img.complete && img.naturalWidth && img.naturalHeight) {
                        canvas.width = img.clientWidth;
                        canvas.height = img.clientHeight;
                        canvas.style.width = img.clientWidth + 'px';
                        canvas.style.height = img.clientHeight + 'px';
                    } else {
                        canvas.width = 800;
                        canvas.height = 450;
                    }

                    ctx.clearRect(0, 0, canvas.width, canvas.height);

                    detectionData.forEach(data => {
                        const x = data.boundingBoxX * canvas.width;
                        const y = data.boundingBoxY * canvas.height;
                        const width = data.boundingBoxWidth * canvas.width;
                        const height = data.boundingBoxHeight * canvas.height;

                        const alpha = Math.max(0.3, data.confidence);
                        const intensity = Math.floor(255 * data.confidence);

                        ctx.fillStyle = `rgba(255, ${255 - intensity}, 0, ${alpha})`;
                        ctx.fillRect(x, y, width, height);

                        ctx.strokeStyle = `rgba(255, 0, 0, ${alpha + 0.2})`;
                        ctx.lineWidth = 2;
                        ctx.strokeRect(x, y, width, height);
                    });
                };

                window.clearHeatmap = function() {
                    const canvas = document.getElementById('heatmapCanvas');
                    if (canvas) {
                        const ctx = canvas.getContext('2d');
                        ctx.clearRect(0, 0, canvas.width, canvas.height);
                    }
                };

                window.toggleImageSize = function(expanded) {
                    const img = document.getElementById('aerialImage');
                    if (img) {
                        if (expanded) {
                            img.style.maxHeight = 'none';
                            img.style.height = 'auto';
                        } else {
                            img.style.maxHeight = '600px';
                        }
                        setTimeout(() => {
                            const canvas = document.getElementById('heatmapCanvas');
                            if (canvas && canvas.previousElementSibling) {
                                const img = canvas.previousElementSibling;
                                canvas.width = img.clientWidth;
                                canvas.height = img.clientHeight;
                                canvas.style.width = img.clientWidth + 'px';
                                canvas.style.height = img.clientHeight + 'px';
                            }
                        }, 100);
                    }
                };

                window.drawRoutes = function(routeData) {
                    const canvas = document.getElementById('heatmapCanvas');
                    if (!canvas) return;
                    const ctx = canvas.getContext('2d');
                    if (!ctx) return;

                    const img = canvas.previousElementSibling;
                    canvas.width = img?.clientWidth || 800;
                    canvas.height = img?.clientHeight || 450;

                    ctx.lineWidth = 3;
                    ctx.strokeStyle = 'rgba(0, 100, 255, 0.7)';
                    ctx.lineCap = 'round';
                    ctx.lineJoin = 'round';

                    routeData.forEach((route, index) => {
                        try {
                            const path = JSON.parse(route.pathJson);
                            if (Array.isArray(path) && path.length > 1) {
                                const hue = (index * 60) % 360;
                                ctx.strokeStyle = `hsla(${hue}, 70%, 50%, 0.7)`;

                                ctx.beginPath();
                                ctx.moveTo(path[0][0] * canvas.width, path[0][1] * canvas.height);

                                for (let i = 1; i < path.length; i++) {
                                    const [x, y] = path[i];
                                    ctx.lineTo(x * canvas.width, y * canvas.height);
                                }

                                ctx.stroke();

                                ctx.fillStyle = `hsla(${hue}, 70%, 40%, 0.9)`;
                                ctx.beginPath();
                                ctx.arc(path[0][0] * canvas.width, path[0][1] * canvas.height, 5, 0, 2 * Math.PI);
                                ctx.fill();
                            }
                        } catch (err) {
                            console.error('Invalid pathJson in route:', route, err);
                        }
                    });
                };
            ");
        }
    }
}